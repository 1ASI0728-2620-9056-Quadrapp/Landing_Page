---
---

<header class="navbar-header" id="navbar">
  <div class="container navbar-container">
    <!-- Logo -->
    <a href="#" class="brand-logo">
      <div class="logo-icon-bg">
        <svg class="logo-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C7.58172 2 4 5.58172 4 10C4 15.25 12 22 12 22C12 22 20 15.25 20 10C20 5.58172 16.4183 2 12 2ZM12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z" fill="white"/>
        </svg>
      </div>
      <span class="brand-name">Quadrapp</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav">
      <a href="#como-funciona" class="nav-link">Cómo funciona</a>
      <a href="#conductores" class="nav-link">Conductores</a>
      <a href="#senales" class="nav-link">Señales</a>
      <a href="#privacidad" class="nav-link">Privacidad</a>
      <a href="#nosotros" class="nav-link">Nosotros</a>
      <a href="#faq" class="nav-link">FAQ</a>
      <a href="#contacto" class="nav-link">Contacto</a>
    </nav>

    <!-- Right Action Button -->
    <div class="nav-actions">
      <a href="#contacto" class="cta-button">
        Contacto Institucional
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Abrir menú">
        <svg class="hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <a href="#como-funciona" class="mobile-nav-link">Cómo funciona</a>
    <a href="#conductores" class="mobile-nav-link">Conductores</a>
    <a href="#senales" class="mobile-nav-link">Señales</a>
    <a href="#privacidad" class="mobile-nav-link">Privacidad</a>
    <a href="#nosotros" class="mobile-nav-link">Nosotros</a>
    <a href="#faq" class="mobile-nav-link">FAQ</a>
    <a href="#contacto" class="mobile-nav-link">Contacto</a>
    <a href="#contacto" class="cta-button full-width">
      Contacto Institucional
    </a>
  </div>
</header>

<style>
  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-icon-bg {
    width: 38px;
    height: 38px;
    background-color: var(--color-teal-primary);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 125, 112, 0.25);
  }

  .logo-svg {
    width: 20px;
    height: 20px;
  }

  .brand-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.03em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #4a636c;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-teal-primary);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cta-button {
    display: inline-block;
    background-color: var(--color-teal-primary);
    color: var(--color-text-white);
    font-size: 0.875rem;
    font-weight: 700;
    padding: 0.65rem 1.35rem;
    border-radius: 24px;
    transition: all var(--transition-fast);
    box-shadow: 0 2px 8px rgba(0, 125, 112, 0.2);
  }

  .cta-button:hover {
    background-color: var(--color-teal-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 125, 112, 0.3);
  }

  .mobile-toggle {
    display: none;
    padding: 0.5rem;
    color: var(--color-text-main);
  }

  .hamburger-icon {
    width: 26px;
    height: 26px;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    background-color: var(--color-bg-card);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .full-width {
    width: 100%;
    text-align: center;
  }

  @media (max-width: 1080px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
    .cta-button:not(.full-width) {
      display: none;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('open');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('open');
      });
    });
  }
</script>
