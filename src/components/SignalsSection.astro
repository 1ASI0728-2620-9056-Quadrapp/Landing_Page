---
---

<section class="signals-section" id="senales">
  <div class="container text-center">
    <span class="section-tag">Predicción con contexto</span>
    <h2 class="section-title">Cuatro señales, una lectura honesta</h2>
    <p class="section-desc centered">
      Las estimaciones combinan información operativa y contexto institucional. Siempre se acompañan con confianza y antigüedad del dato.
    </p>

    <!-- 4 Cards Grid -->
    <div class="signals-grid">
      <!-- Card 1 -->
      <div class="signal-card">
        <div class="signal-icon-bg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 8v4l3 3"/>
            <circle cx="12" cy="12" r="9"/>
            <path d="M3.05 11a9 9 0 1 1 .5 4"/>
          </svg>
        </div>
        <h3>Ocupación histórica</h3>
        <p>Patrones por día y franja horaria</p>
      </div>

      <!-- Card 2 -->
      <div class="signal-card">
        <div class="signal-icon-bg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 3L4 7l4 4"/>
            <path d="M4 7h16"/>
            <path d="M16 21l4-4-4-4"/>
            <path d="M20 17H4"/>
          </svg>
        </div>
        <h3>Flujo de accesos</h3>
        <p>Entradas y salidas recientes</p>
      </div>

      <!-- Card 3 -->
      <div class="signal-card">
        <div class="signal-icon-bg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
            <rect x="7" y="14" width="3" height="3" fill="currentColor" fill-opacity="0.3"/>
            <rect x="14" y="14" width="3" height="3" fill="currentColor" fill-opacity="0.3"/>
          </svg>
        </div>
        <h3>Calendario académico</h3>
        <p>Periodos, cierres y jornadas especiales</p>
      </div>

      <!-- Card 4 -->
      <div class="signal-card">
        <div class="signal-icon-bg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5.8 11.3L2 14l3.5 3.5L8.3 14"/>
            <path d="M4 4l16 16"/>
            <path d="M15 4l5 1-1 5"/>
            <path d="M12 9l3 3"/>
          </svg>
        </div>
        <h3>Eventos</h3>
        <p>Cambios esperados por zona y horario</p>
      </div>
    </div>

    <!-- Info Transparency Banner -->
    <div class="transparency-banner">
      <div class="banner-left">
        <div class="info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
        </div>
        <p class="banner-text">
          Una predicción orienta; no reserva un espacio. Si faltan lecturas, los estados UNKNOWN se mantienen separados y la confianza se ajusta.
        </p>
      </div>
      <span class="banner-tag">Transparencia operativa</span>
    </div>
  </div>
</section>

<style>
  .signals-section {
    padding: 6rem 0;
    background-color: var(--color-bg-page);
  }

  .text-center {
    text-align: center;
  }

  .centered {
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3.5rem;
  }

  .signals-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .signal-card {
    background-color: #f3f9f8;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem;
    transition: all var(--transition-smooth);
  }

  .signal-card:hover {
    transform: translateY(-4px);
    background-color: #ffffff;
    border-color: rgba(0, 125, 112, 0.3);
    box-shadow: 0 12px 24px rgba(0, 125, 112, 0.06);
  }

  .signal-icon-bg {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background-color: #d6eee8;
    color: var(--color-teal-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .signal-icon-bg svg {
    width: 22px;
    height: 22px;
  }

  .signal-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .signal-card p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  /* Transparency Banner */
  .transparency-banner {
    background-color: #e3f2ef;
    border-radius: 16px;
    padding: 1.25rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-align: left;
    border: 1px solid rgba(0, 125, 112, 0.15);
  }

  .banner-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .info-icon {
    width: 28px;
    height: 28px;
    color: var(--color-teal-primary);
    flex-shrink: 0;
  }

  .banner-text {
    font-size: 0.9375rem;
    color: var(--color-text-main);
    font-weight: 500;
    line-height: 1.45;
  }

  .banner-tag {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-teal-primary);
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  @media (max-width: 1024px) {
    .signals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .signals-grid {
      grid-template-columns: 1fr;
    }
    .transparency-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
