---
---

<section class="contact-section" id="contacto">
  <div class="container contact-grid">
    <!-- Left Column: Info & Checklist -->
    <div class="contact-info-column">
      <span class="section-tag-light">Contacto Institucional</span>
      <h2 class="contact-title">Conversemos sobre tu operación</h2>
      <p class="contact-desc">
        Cuéntanos cómo funciona tu estacionamiento y qué preguntas necesita responder tu equipo. La información de este formulario se usa únicamente para dar seguimiento a tu solicitud.
      </p>

      <div class="contact-checklist">
        <div class="check-item">
          <div class="check-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <span>Infraestructura y zonas</span>
        </div>

        <div class="check-item">
          <div class="check-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <span>Operación y horarios</span>
        </div>

        <div class="check-item">
          <div class="check-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <span>Calendario y eventos</span>
        </div>

        <div class="check-item">
          <div class="check-icon-circle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <span>Necesidades de reporte</span>
        </div>
      </div>
    </div>

    <!-- Right Column: White Form Card -->
    <div class="contact-form-wrapper">
      <div class="contact-card">
        <form id="institutional-form">
          <!-- Row 1: Nombre & Cargo -->
          <div class="form-row">
            <div class="form-group">
              <label for="inst-name">Nombre</label>
              <input type="text" id="inst-name" required placeholder="Tu nombre" />
            </div>
            <div class="form-group">
              <label for="inst-role">Cargo</label>
              <input type="text" id="inst-role" required placeholder="Tu rol" />
            </div>
          </div>

          <!-- Row 2: Correo Institucional -->
          <div class="form-group">
            <label for="inst-email">Correo institucional</label>
            <input type="email" id="inst-email" required placeholder="nombre@institución.edu" />
          </div>

          <!-- Row 3: Institución -->
          <div class="form-group">
            <label for="inst-organization">Institución</label>
            <input type="text" id="inst-organization" required placeholder="Nombre de la institución" />
          </div>

          <!-- Row 4: ¿Qué necesitan entender o mejorar? -->
          <div class="form-group">
            <label for="inst-context">¿Qué necesitan entender o mejorar?</label>
            <textarea id="inst-context" rows="3" placeholder="Describe brevemente su contexto"></textarea>
          </div>

          <!-- Checkbox Terms -->
          <div class="checkbox-group">
            <input type="checkbox" id="terms-check" required />
            <label for="terms-check">Acepto que Integra Labs use estos datos para responder mi solicitud.</label>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="submit-btn-teal">
            <span>Enviar solicitud</span>
            <svg class="send-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13"/>
              <path d="M22 2L15 22L11 13L2 9L22 2Z"/>
            </svg>
          </button>
        </form>

        <div class="form-success-banner" id="inst-success">
          <div class="success-circle">✓</div>
          <h3>¡Solicitud recibida!</h3>
          <p>Un especialista de Integra Labs se pondrá en contacto a la brevedad.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 6rem 0;
    background-color: var(--color-bg-hero);
    color: #ffffff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .section-tag-light {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #3bf1d4;
    margin-bottom: 0.75rem;
  }

  .contact-title {
    font-size: 2.5rem;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }

  .contact-desc {
    font-size: 1.1rem;
    color: #9cb8c5;
    line-height: 1.6;
    margin-bottom: 2.25rem;
  }

  .contact-checklist {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .check-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: #ffffff;
  }

  .check-icon-circle {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #3bf1d4;
    flex-shrink: 0;
  }

  .check-icon-circle svg {
    width: 12px;
    height: 12px;
  }

  /* Form Card */
  .contact-form-wrapper {
    display: flex;
    justify-content: center;
  }

  .contact-card {
    width: 100%;
    background-color: #ffffff;
    border-radius: 24px;
    padding: 2.5rem;
    color: var(--color-text-main);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
  }

  #institutional-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: 0.9375rem;
    font-family: inherit;
    background-color: #ffffff;
    transition: all 0.2s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-teal-primary);
    box-shadow: 0 0 0 3px rgba(0, 125, 112, 0.12);
  }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-top: 0.25rem;
  }

  .checkbox-group input {
    margin-top: 3px;
    accent-color: var(--color-teal-primary);
  }

  .checkbox-group label {
    font-size: 0.78125rem;
    color: var(--color-text-muted);
    line-height: 1.35;
  }

  .submit-btn-teal {
    width: 100%;
    background-color: var(--color-teal-primary);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.85rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 0.5rem;
    transition: all var(--transition-fast);
  }

  .submit-btn-teal:hover {
    background-color: var(--color-teal-hover);
    box-shadow: 0 4px 14px rgba(0, 125, 112, 0.3);
  }

  .send-icon {
    width: 18px;
    height: 18px;
  }

  .form-success-banner {
    display: none;
    text-align: center;
    padding: 2rem 0;
  }

  .success-circle {
    width: 50px;
    height: 50px;
    background-color: var(--status-high-bg);
    color: var(--status-high-text);
    font-size: 1.5rem;
    font-weight: 800;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem auto;
  }

  .form-success-banner h3 {
    font-size: 1.25rem;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }

  .form-success-banner p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('institutional-form') as HTMLFormElement;
  const successBanner = document.getElementById('inst-success');

  if (form && successBanner) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.style.display = 'none';
      successBanner.style.display = 'block';

      setTimeout(() => {
        form.reset();
        form.style.display = 'flex';
        successBanner.style.display = 'none';
      }, 4000);
    });
  }
</script>
