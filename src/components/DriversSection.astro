---
---

<section class="drivers-section" id="conductores">
  <div class="container drivers-grid">
    <!-- Left Column: Interactive Mobile Mockup -->
    <div class="mockup-column">
      <div class="phone-frame animate-float">
        <!-- Phone Screen Container -->
        <div class="phone-screen">
          <!-- Mockup Header -->
          <div class="app-header">
            <div class="app-brand">
              <div class="app-logo-small">
                <svg viewBox="0 0 24 24" fill="none">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C7.58172 2 4 5.58172 4 10C4 15.25 12 22 12 22C12 22 20 15.25 20 10C20 5.58172 16.4183 2 12 2ZM12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z" fill="white"/>
                </svg>
              </div>
              <span class="app-title">Quadrapp</span>
            </div>
            <div class="app-user-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
          </div>

          <!-- App Main Question -->
          <h3 class="app-question">¿Encontraré espacio al llegar?</h3>

          <!-- Main Dark Status Card -->
          <div class="main-status-card" id="status-card">
            <div class="status-card-top">
              <span class="badge-availability" id="status-badge">Buena disponibilidad</span>
              <span class="status-percentage" id="status-percent">82%</span>
            </div>

            <h4 class="status-main-text" id="status-heading">
              Es probable que encuentres espacio.
            </h4>

            <div class="status-meta">
              <span id="eta-label">Llegas en 27 min</span>
              <span class="meta-dot">•</span>
              <span>Hace 2 min</span>
            </div>
          </div>

          <!-- Time Horizon Rows (Interactive Selector) -->
          <div class="horizon-list">
            <button class="horizon-item active" data-eta="15" data-percent="88%" data-badge="Alta disponibilidad" data-text="Es muy probable que encuentres espacio rápido." data-color="high">
              <span class="time-slot">15 min</span>
              <span class="slot-percent high">88%</span>
            </button>

            <button class="horizon-item" data-eta="30" data-percent="82%" data-badge="Buena disponibilidad" data-text="Es probable que encuentres espacio." data-color="high">
              <span class="time-slot">30 min</span>
              <span class="slot-percent high">82%</span>
            </button>

            <button class="horizon-item" data-eta="45" data-percent="61%" data-badge="Disponibilidad moderada" data-text="Posible espacio pero áreas principales casi llenas." data-color="med">
              <span class="time-slot">45 min</span>
              <span class="slot-percent med">61%</span>
            </button>

            <button class="horizon-item" data-eta="60" data-percent="38%" data-badge="Alta ocupación" data-text="Capacidad crítica esperada. Considera llegar antes." data-color="low">
              <span class="time-slot">60 min</span>
              <span class="slot-percent low">38%</span>
            </button>
          </div>

          <p class="app-disclaimer">
            ETA calculado en tu dispositivo. Solo se comparten minutos de llegada, nunca tu ubicación.
          </p>
        </div>
      </div>
    </div>

    <!-- Right Column: Info & Downloads -->
    <div class="info-column">
      <span class="section-tag">Para Conductores</span>
      <h2 class="section-title">Llega con una expectativa más clara</h2>
      <p class="section-desc">
        Consulta en segundos la probabilidad de encontrar espacio a tu llegada, con lenguaje sencillo y contexto suficiente para decidir.
      </p>

      <!-- Checklist -->
      <ul class="drivers-checklist">
        <li>
          <svg class="check-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          <span>ETA calculado en tu dispositivo</span>
        </li>
        <li>
          <svg class="check-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          <span>Disponibilidad actual, confianza y antigüedad</span>
        </li>
        <li>
          <svg class="check-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          <span>Predicciones a 15, 30, 45 y 60 minutos</span>
        </li>
        <li>
          <svg class="check-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          <span>Alertas ante cambios, datos viejos o baja señal</span>
        </li>
      </ul>

      <!-- App Download Buttons -->
      <div class="download-buttons">
        <button class="btn-download primary-dl">
          <span>Descargar para iOS</span>
          <svg class="dl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
        </button>

        <button class="btn-download secondary-dl">
          <span>Descargar para Android</span>
          <svg class="dl-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
        </button>
      </div>

      <p class="download-footnote">
        Disponibilidad de descarga sujeta al despliegue de tu institución.
      </p>
    </div>
  </div>
</section>

<style>
  .drivers-section {
    padding: 6rem 0;
    background-color: #f7faf9;
    border-top: 1px solid var(--color-border-light);
  }

  .drivers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* Mockup Styling */
  .mockup-column {
    display: flex;
    justify-content: center;
  }

  .phone-frame {
    width: 100%;
    max-width: 360px;
    background: #ffffff;
    border-radius: 36px;
    padding: 12px;
    box-shadow: 
      0 24px 48px -12px rgba(12, 35, 42, 0.18),
      0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .phone-screen {
    background-color: #ffffff;
    border-radius: 28px;
    padding: 1.25rem;
    border: 1px solid #edf2f0;
  }

  .app-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .app-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .app-logo-small {
    width: 24px;
    height: 24px;
    background-color: var(--color-teal-primary);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .app-logo-small svg {
    width: 14px;
    height: 14px;
  }

  .app-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .app-user-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: #eef5f3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-main);
  }

  .app-user-icon svg {
    width: 16px;
    height: 16px;
  }

  .app-question {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .main-status-card {
    background-color: var(--color-bg-hero);
    color: #ffffff;
    border-radius: var(--radius-md);
    padding: 1.25rem;
    margin-bottom: 1rem;
    transition: all 0.3s ease;
  }

  .status-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .badge-availability {
    background-color: #d5f2e8;
    color: #085644;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
  }

  .status-percentage {
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }

  .status-main-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .status-meta {
    font-size: 0.75rem;
    color: #8daab6;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-dot {
    opacity: 0.5;
  }

  .horizon-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .horizon-item {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    background-color: var(--status-high-bg);
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .horizon-item.active {
    border-color: var(--color-teal-primary);
    box-shadow: 0 2px 6px rgba(0, 125, 112, 0.15);
  }

  .time-slot {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .slot-percent {
    font-size: 0.875rem;
    font-weight: 800;
  }

  .slot-percent.high {
    color: var(--status-high-text);
  }

  .slot-percent.med {
    color: var(--status-med-text);
  }

  .slot-percent.low {
    color: var(--status-low-text);
  }

  .horizon-item[data-color="med"] {
    background-color: var(--status-med-bg);
  }

  .horizon-item[data-color="low"] {
    background-color: var(--status-low-bg);
  }

  .app-disclaimer {
    font-size: 0.6875rem;
    color: #728c96;
    line-height: 1.35;
  }

  /* Info Column */
  .info-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .drivers-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
  }

  .drivers-checklist li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .check-green {
    width: 20px;
    height: 20px;
    color: var(--color-teal-primary);
    flex-shrink: 0;
  }

  .download-buttons {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 0.75rem 1.35rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .primary-dl {
    background-color: var(--color-teal-primary);
    color: var(--color-text-white);
  }

  .primary-dl:hover {
    background-color: var(--color-teal-hover);
    transform: translateY(-1px);
  }

  .secondary-dl {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
  }

  .secondary-dl:hover {
    background-color: #f0f7f5;
    border-color: var(--color-teal-primary);
  }

  .dl-icon {
    width: 18px;
    height: 18px;
  }

  .download-footnote {
    font-size: 0.8125rem;
    color: var(--color-text-light);
  }

  @media (max-width: 960px) {
    .drivers-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>

<script>
  // Interactive mockup slot selector logic
  const horizonItems = document.querySelectorAll('.horizon-item');
  const statusBadge = document.getElementById('status-badge');
  const statusPercent = document.getElementById('status-percent');
  const statusHeading = document.getElementById('status-heading');
  const etaLabel = document.getElementById('eta-label');

  horizonItems.forEach(item => {
    item.addEventListener('click', () => {
      horizonItems.forEach(i => i.classList.remove('active'));
      item.classList.add('active');

      const eta = item.getAttribute('data-eta');
      const percent = item.getAttribute('data-percent');
      const badge = item.getAttribute('data-badge');
      const text = item.getAttribute('data-text');

      if (statusBadge && statusPercent && statusHeading && etaLabel) {
        statusBadge.textContent = badge || '';
        statusPercent.textContent = percent || '';
        statusHeading.textContent = text || '';
        etaLabel.textContent = `Llegas en ${eta} min`;
      }
    });
  });
</script>
